{
  "$schema": "https://raw.githubusercontent.com/nickelghost/tauri-v2-schema/refs/heads/main/tauri.conf.json",
  "productName": "Tapir",
  "version": "2.1.0",
  "identifier": "com.tapir.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Tapir",
        "width": 960,
        "height": 640,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Tapir.entitlements"
    }
  }
}
